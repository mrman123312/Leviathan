# Optional Hugging Face token for gated/private assets.
HF_TOKEN=

# Local checkpoint storage. Do not point this inside a tracked source directory unless ignored.
LEVIATHAN_MODEL_DIR=./models/checkpoints

# Canonical DeepSeek-V4-Pro-Base checkpoint directory used by the MoP preparation/runtime tools.
LEVIATHAN_DEEPSEEK_V4_DIR=./models/checkpoints/deepseek-v4-pro-base

# OpenAI-compatible V4 serving endpoint used by scripts/run_prompt.py --backend endpoint.
LEVIATHAN_INFERENCE_URL=http://127.0.0.1:8000
LEVIATHAN_SERVED_MODEL=deepseek-ai/DeepSeek-V4-Pro-Base
LEVIATHAN_INFERENCE_API_KEY=

# Optional Hugging Face cache root.
HF_HOME=./.cache/huggingface
