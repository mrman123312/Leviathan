# Optional Hugging Face token for gated/private assets.
HF_TOKEN=

# Local checkpoint storage. Do not point this inside a tracked source directory unless ignored.
LEVIATHAN_MODEL_DIR=./models/checkpoints

# Canonical DeepSeek-V4-Pro-Base checkpoint directory used by the MoP preparation tool.
LEVIATHAN_DEEPSEEK_V4_DIR=./models/checkpoints/deepseek-v4-pro-base

# Optional Hugging Face cache root.
HF_HOME=./.cache/huggingface
